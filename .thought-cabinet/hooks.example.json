{
  "hooks": {
    "PostWorktreeAdd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Worktree @ $THC_WORKTREE_PATH successfully added'"
          }
        ]
      }
    ],
    "PostWorktreeMerge": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Worktree merged successfully'"
          }
        ]
      }
    ],
    "PostWorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Worktree @ $THC_WORKTREE_PATH removed'"
          }
        ]
      }
    ],
    "PostThoughtsSync": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Thoughts synced at $(date)' >> .thought-cabinet/sync.log"
          }
        ]
      }
    ]
  }
}
